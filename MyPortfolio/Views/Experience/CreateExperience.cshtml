@model Experience
@{
    ViewData["Title"] = "CreateExperience";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Experiences</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Experience List</div>
					</div>
					<div class="card-body">
						
						<form method="post">
							<label>Experience title and Company Information</label>
							<input type="text" asp-for="Head" class="form-control" />

							<label>Company Name</label>
							<input type="text" asp-for="Title" class="form-control" />

							<label>Working Dates</label>
							<input type="text" asp-for="Date" class="form-control" />

							<label>Description</label>
							<textarea rows="4" asp-for="Description" class="form-control"></textarea>

							<button type="submit" class="btn btn-primary mt-3">Create</button>
						</form>
						
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

