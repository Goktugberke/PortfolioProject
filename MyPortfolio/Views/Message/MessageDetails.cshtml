@model Message
@{
    ViewData["Title"] = "MessageDetails";
    Layout = "~/Views/Layout/Index.cshtml";
}

<input type="hidden" id="MessageId" value="@Model.MessageId" />

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Messages</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Message Details</div>
					</div>
					<div class="card-body">
						<b>Send by : </b> @Model.NameSurname <br>
						<b>Email :</b> @Model.Email <br>
						<b>Date :</b>  @Model.CreatedDate.ToShortDateString() <br><br>
						<b>Message :</b> @Model.MessageDetail
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

