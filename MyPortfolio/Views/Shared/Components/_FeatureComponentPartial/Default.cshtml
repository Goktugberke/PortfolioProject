@model List<MyPortfolio.DAL.Entities.Feature>

<section id="home" class="s-home page-hero target-section" data-parallax="scroll" data-image-src="https://i.hizliresim.com/e4j6m93.jpg"
         data-natural-width=3000 data-natural-height=2000 data-position-y=center>

    <div class="overlay"></div>
    <div class="shadow-overlay"></div>

	@foreach (var item in Model)
	{
		 <div class="home-content">

        <div class="row home-content__main">

            <h3>@item.Title</h3>

            <h1>
    @*             I am Goktug Gungoren. <br> *@
    @*             I am a full stack  <br> *@
				@* developer and designer. *@
                @item.Description
            </h1>

            <div class="home-content__buttons">
                <a href="#works" class="smoothscroll btn btn--stroke">
                    Latest Projects
                </a>
                <a href="#about" class="smoothscroll btn btn--stroke">
                    More About Me
                </a>
            </div>

            <div class="home-content__scroll">
                <a href="#about" class="scroll-link smoothscroll">
                    <span>Scroll Down</span>
                </a>
            </div>

        </div>

    </div> <!-- end home-content -->
	})

   

    <ul class="home-social">
        <li>
            <a href="https://www.instagram.com/goktugberke/"><i class="im im-instagram" aria-hidden="true"></i><span>Instagram</span></a>
        </li>
        <li>
            <a href="https://github.com/Goktugberke"><i class="im im-github" aria-hidden="true"></i><span>Github</span></a>
        </li>
        <li>
            <a href="https://www.linkedin.com/in/g%C3%B6ktu%C4%9F-berke-g%C3%BCng%C3%B6ren-5a7322239/"><i class="im im-linkedin" aria-hidden="true"></i><span>LinkedIn</span></a>
        </li>
    </ul>
    <!-- end home-social -->

</section>
