@model List<Contact>
@{
    ViewData["Title"] = "ContactList";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Experiences</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Experience List</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							You can add, edit and delete your experiences here.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Title</th>
									<th scope="col">Description</th>
									<th scope="col">Phone1</th>
									<th scope="col">Phone2</th>
									<th scope="col">Email1</th>
									<th scope="col">Email2</th>
									<th scope="col">Address</th>
									<th scope="col">Delete</th>
									<th scope="col">Update</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.ContactId</td>
										<td>@item.Title</td>
										<td>@item.Description</td>
										<td>@item.Phone1</td>
										<td>@item.Phone2</td>
										<td>@item.Email1</td>
										<td>@item.Email2</td>
										<td>@item.Address</td>
										<td><a href=" /Contact/DeleteContact/@item.ContactId" class="btn btn-danger">Delete<a/></td>
										<td><a href=" /Contact/UpdateContact/@item.ContactId" class="btn btn-success">Update<a/></td>

									</tr>
								}
							</tbody>
						</table>
						<td><a href=" /Contact/CreateContact/" class="btn btn-primary">Add New Contact<a/></td>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

