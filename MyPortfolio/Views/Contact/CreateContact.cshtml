@model Contact
@{
    ViewData["Title"] = "CreateContact";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Contact Informations</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Contact Informations List</div>
					</div>
					<div class="card-body">

						<form method="post">
							<label>Title</label>
							<input type="text" asp-for="Title" class="form-control" />

							<label>Description</label>
							<textarea rows="4" asp-for="Description" class="form-control"></textarea>

							<label>Phone 1</label>
							<input type="text" asp-for="Phone1" class="form-control" />

							<label>Phone 2</label>
							<input type="text" asp-for="Phone2" class="form-control" />

							<label>Email 1</label>
							<input type="text" asp-for="Email1" class="form-control" />

							<label>Email 2</label>
							<input type="text" asp-for="Email2" class="form-control" />

							<label>Address</label>
							<input type="text" asp-for="Address" class="form-control" />

							

							<button type="submit" class="btn btn-primary mt-3">Create</button>
						</form>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>

