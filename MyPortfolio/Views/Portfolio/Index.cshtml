@model List<Portfolio>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Projects</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Experience List</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							You can add, edit and delete your experiences here.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Title</th>
									<th scope="col">SubTitle</th>
									<th scope="col">Url</th>
									<th scope="col">Description</th>
									<th scope="col">Delete</th>
									<th scope="col">Update</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.PortfolioId</td>
										<td>@item.Title</td>
										<td>@item.SubTitle</td>
										<td>@item.Title</td>
										<td>@item.Url</td>
										<td><a href="/Portfolio/PortfolioDetails/@item.PortfolioId" class="btn btn-primary">See Description<a /></td>
										<td><a href="/Portfolio/DeletePortfolio/@item.PortfolioId" class="btn btn-danger">Delete<a /></td>
										<td><a href="/Portfolio/UpdatePortfolio/@item.PortfolioId" class="btn btn-success">Update<a /></td>

									</tr>
								}
							</tbody>
						</table>
						<td><a href=" /Portfolio/CreatePortfolio/" class="btn btn-primary">Add New Project<a /></td>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

