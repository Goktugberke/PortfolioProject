@model Portfolio
@{
    ViewData["Title"] = "UpdatePortfolio";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Projects</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Update Projects Page</div>
					</div>
					<div class="card-body">

						<form method="post">
							<input type="hidden" asp-for="PortfolioId" />
							<label>Experience title and Company Information</label>
							<input type="text" asp-for="Title" class="form-control" />

							<label>Company Name</label>
							<input type="text" asp-for="SubTitle" class="form-control" />

							<label>Working Dates</label>
							<input type="text" asp-for="ThumbnailImageUrl" class="form-control" />

							<label>Description</label>
							<textarea rows="4" asp-for="Url" class="form-control"></textarea>

							<label>Description</label>
							<textarea rows="4" asp-for="Description" class="form-control"></textarea>

							<label>Description</label>
							<textarea rows="4" asp-for="GalleryImageUrl" class="form-control"></textarea>

							<button type="submit" class="btn btn-warning mt-3">Update</button>
						</form>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>

