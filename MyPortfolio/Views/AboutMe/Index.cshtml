@model List<About>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">About Me</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">About Me Content</div>
					</div>
					<div class="card-body">
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Title</th>
									<th scope="col">SubDescription</th>
									<th scope="col">Details</th>
									<th scope="col">Delete</th>
									<th scope="col">Update</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.AboutId</td> 
										<td>@item.Title</td> 
										<td>@item.SubDescription</td> 
										<td>@item.Details</td> 
										<td><a href="/AboutMe/DeleteAboutMe/@item.AboutId" class="btn btn-danger">Delete<a/></td>
										<td><a href="/AboutMe/UpdateAboutMe/@item.AboutId" class="btn btn-success">Update<a/></td>

									</tr>
								}
							</tbody>
						</table>
						<td><a href=" /AboutMe/CreateAboutMe/" class="btn btn-primary">Add New About<a/></td>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>

