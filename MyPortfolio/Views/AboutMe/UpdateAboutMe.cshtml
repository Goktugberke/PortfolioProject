@model	About
@{
    ViewData["Title"] = "UpdateAboutMe";
    Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">About Me</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Update About Me Page</div>
					</div>
					<div class="card-body">

						<form method="post">
							<input type="hidden" asp-for="AboutId" />
							<label>About Me Title</label>
							<input type="text" asp-for="Title" class="form-control" />

							<label>About Me Subdescription</label>
							<input type="text" asp-for="SubDescription" class="form-control" />

							<label>Details</label>
							<input type="text" asp-for="Details" class="form-control" />

							<button type="submit" class="btn btn-warning mt-3">Update</button>
						</form>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>

