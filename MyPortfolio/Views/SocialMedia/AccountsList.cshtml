@model List<SocialMedia>
@{
    ViewData["Title"] = "AccountsList";
    Layout = "~/Views/Layout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Experiences</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Experience List</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							You can add, edit and delete your experiences here.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Title</th>
									<th scope="col">Url</th>
									<th scope="col">Icon</th>
									<th scope="col">Delete</th>
									<th scope="col">Update</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.SocialMediaId</td>
										<td>@item.Titlw</td>
										<td>@item.Url</td>
										<td>@item.Icon</td>
										<td><a href=" /SocialMedia/DeleteAccount/@item.SocialMediaId" class="btn btn-danger">Delete<a /></td>
										<td><a href=" /SocialMedia/UpdateAccount/@item.SocialMediaId" class="btn btn-success">Update<a /></td>

									</tr>
								}
							</tbody>
						</table>
						<td><a href=" /SocialMedia/CreateAccount/" class="btn btn-primary">Add New Account<a /></td>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

