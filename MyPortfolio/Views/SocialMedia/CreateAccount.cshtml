@model SocialMedia
@{
    ViewData["Title"] = "CreateAccount";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Contact Informations</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Contact Informations List</div>
					</div>
					<div class="card-body">

						<form method="post">
							<input type="hidden" asp-for="SocialMediaId" />

							<label>Title</label>
							<input type="text" asp-for="Titlw" class="form-control" />

							<label>Url</label>
							<textarea rows="4" asp-for="Url" class="form-control"></textarea>

							<label>Icon Class</label>
							<input type="text" asp-for="Icon" class="form-control" />

							<button type="submit" class="btn btn-primary mt-3">Create</button>
						</form>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>



