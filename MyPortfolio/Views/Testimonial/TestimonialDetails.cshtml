@model Testimonial
@{
    ViewData["Title"] = "TestimonialDetails";
    Layout = "~/Views/Layout/Index.cshtml";
}

<input type="hidden" id="TestimonialIdd" value="@Model.TestimonialId" />

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Testimonial</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Testimonial Details</div>
					</div>
					<div class="card-body">
						<b>Send by : </b> @Model.NameSurname <br>
						<b>Email :</b> @Model.Title <br>
						<b>Date :</b>  @Model.ImageUrl <br><br>
						<b>Message :</b> @Model.Description
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

