@model Testimonial
@{
    ViewData["Title"] = "CreateTestimonial";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Testimonial Informations</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Testimonial Informations</div>
					</div>
					<div class="card-body">

						<form method="post">
							<label>Name Surname</label>
							<input type="text" asp-for="NameSurname" class="form-control" />

							<label>Title</label>
							<input type="text" asp-for="Title" class="form-control" />

							<label>Description</label>
							<textarea rows="4" asp-for="Description" class="form-control"></textarea>

							<label>ImageUrl</label>
							<input type="text" asp-for="ImageUrl" class="form-control" />

							<button type="submit" class="btn btn-primary mt-3">Create</button>
						</form>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>


