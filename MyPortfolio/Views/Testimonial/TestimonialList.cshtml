@model List<Testimonial>
@{
    ViewData["Title"] = "TestimonialList";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Experiences</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Experience List</div>
					</div>
					<div class="card-body">
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Name Surname</th>
									<th scope="col">Title</th>
									<th scope="col">ImageUrl</th>
									<th scope="col">See Description</th>
									<th scope="col">Delete</th>
									<th scope="col">Update</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.TestimonialId</td>
										<td>@item.NameSurname</td>
										<td>@item.Title</td>
										<td>@item.ImageUrl</td>
										<td><a href=" /Testimonial/TestimonialDetails/@item.TestimonialId" class="btn btn-info">See Description<a/></td>
										<td><a href=" /Testimonial/DeleteTestimonial/@item.TestimonialId" class="btn btn-danger">Delete<a/></td>
										<td><a href=" /Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-success">Update<a/></td>

									</tr>
								}
							</tbody>
						</table>
						<td><a href=" /Testimonial/CreateTestimonial/" class="btn btn-primary">Add New Testimonial<a/></td>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

