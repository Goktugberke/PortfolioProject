@model TodoList
@{
    ViewData["Title"] = "UpdateToDoList";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">To Do </h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Update To Do Item Page</div>
					</div>
					<div class="card-body">

						<form method="post">
							<input type="hidden" asp-for="ToDoListId" />

							<label>Company Name</label>
							<input type="text" asp-for="Title" class="form-control" />

							<label>Image Url</label>
							<input type="text" asp-for="ImageUrl" class="form-control" />

							<label>To Do Dates</label>
							<input type="Date" asp-for="Date" class="form-control" />

							<button type="submit" class="btn btn-warning mt-3">Update</button>
						</form>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>
